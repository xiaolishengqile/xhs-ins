{
  "name": "social-media-image-collector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec test/**/*.test.js",
    "test:unit": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:integration": "node --test --test-reporter=spec test/integration/*.test.js",
    "test:e2e": "node --test --test-reporter=spec test/e2e/*.test.js",
    "check": "find src public scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "install:browser": "playwright install chromium",
    "smoke:xhs": "node scripts/smoke-xiaohongshu.js"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "yazl": "3.3.1"
  }
}
